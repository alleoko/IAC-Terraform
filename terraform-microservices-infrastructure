provider "aws" {
  region = "us-west-2"
}

# Create a Virtual Private Cloud (VPC)
resource "aws_vpc" "main" {
  cidr_block = "10.0.0.0/16"

  tags = {
    Name = "main-vpc"
  }
}

# Create public subnets
resource "aws_subnet" "public_subnet_1" {
  vpc_id                  = aws_vpc.main.id
  cidr_block                = "10.0.1.0/24"
  availability_zone           = "us-west-2a"

  tags = {
    Name = "public-subnet-1"
  }
}

resource "aws_subnet" "public_subnet_2" {
  vpc_id                  = aws_vpc.main.id
  cidr_block                = "10.0.2.0/24"
  availability_zone           = "us-west-2b"

  tags = {
    Name = "public-subnet-2"
  }
}

# Create an Internet Gateway
resource "aws_internet_gateway" "igw" {
  vpc_id = aws_vpc.main.id

  tags = {
    Name = "main-igw"
  }
}

# Create a security group
resource "aws_security_group" "microservice_sg" {
  vpc_id = aws_vpc.main.id

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "microservice-sg"
  }
}

# Define an ECS cluster
resource "aws_ecs_cluster" "microservices_cluster" {
  name = "microservices-cluster"
}

# Example of a microservice task definition
resource "aws_ecs_task_definition" "microservice_task" {
  family                   = "microservice"
  network_mode            = "awsvpc"
  requires_compatibilities  = ["FARGATE"]

  container_definitions = jsonencode([
    {
      name      = "my-microservice"
      image     = "my-docker-repo/my-microservice:latest"
      cpu       = 256
      memory    = 512
      essential = true
      port_mappings = [
        {
          containerPort = 80
          hostPort      = 80
        }
      ]
    }
  ])
}

# Create an ECS service to run the microservice
resource "aws_ecs_service" "microservice_service" {
  name            = "microservice-service"
  cluster         = aws_ecs_cluster.microservices_cluster.id
  task_definition = aws_ecs_task_definition.microservice_task.arn
  desired_count   = 3

  launch_type = "FARGATE"

  network_configuration {
    subnets          = [aws_subnet.public_subnet_1.id, aws_subnet.public_subnet_2.id]
    security_groups  = [aws_security_group.microservice_sg.id]
    assign_public_ip = true
  }
}

# Load Balancer to distribute traffic to the microservices
resource "aws_lb" "microservice_lb" {
  name               = "microservice-lb"
  internal           = false
  load_balancer_type = "application"
